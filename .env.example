# Absolute base URL clients receive (your tailnet address).
DRIP_BASE_URL=https://homelab.your-tailnet.ts.net
# Optional write token (leave unset to disable auth).
# DRIP_TOKEN=change-me
# DRIP_DATA_DIR must match the compose volume mount (/data); do not change unless you also change docker-compose.yml
DRIP_DATA_DIR=/data
DRIP_DEFAULT_TTL=24h
DRIP_MAX_TTL=168h
DRIP_MAX_SIZE=100mb
DRIP_SWEEP_INTERVAL=60s
PORT=8787
# Host address the container port binds to (docker-compose.yml). Default: 127.0.0.1.
# DRIP_BIND=127.0.0.1
